{
  "description": "Stops the pr-map dashboard server when the Claude Code session ends",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/cleanup-server.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
